# Lumeon Mejora - plantilla segura
# NO pongas credenciales reales en este archivo.

SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=production

# Orígenes del frontend, separados por coma.
ALLOWED_ORIGINS=https://your-domain.example

# Producción: conexión PostgreSQL/Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Administrador inicial (solo instalación inicial; cambia estas credenciales).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# Email opcional.
RESEND_API_KEY=
MAIL_FROM_NAME=LUMEON

# WhatsApp / CallMeBot opcional.
CALLMEBOT_ENABLED=0
CALLMEBOT_DEFAULT_PHONE=
CALLMEBOT_API_KEY=

# Cookies: true cuando la aplicación está detrás de HTTPS.
SESSION_COOKIE_SECURE=true
PORT=5000
