# Application
SECRET_KEY=change-me
FLASK_ENV=development
ALLOWED_ORIGINS=http://localhost:5000
SESSION_COOKIE_SECURE=0

# Supabase PostgreSQL direct connection string
# Use the database connection string from Supabase, preferably the pooler for hosted deployments.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Initial admin for a fresh installation only
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# Email provider (optional)
RESEND_API_KEY=
MAIL_FROM_NAME=LUMEON

# WhatsApp / CallMeBot (optional)
CALLMEBOT_ENABLED=0
CALLMEBOT_DEFAULT_PHONE=+573045201946
CALLMEBOT_API_KEY=
