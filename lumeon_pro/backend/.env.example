# Never commit the real .env file.
FLASK_ENV=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
DB_APPLICATION_NAME=lumeon-pro
SESSION_COOKIE_SECURE=true
LUMEON_AUTO_MIGRATE=false
ALLOWED_ORIGINS=https://lumeon.pythonanywhere.com

# Optional WhatsApp / CallMeBot
CALLMEBOT_API_KEY=
CALLMEBOT_DEFAULT_PHONE=
CALLMEBOT_TIMEOUT=15
WHATSAPP_PROVIDER=callmebot

# Initial administrator
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=

# Leave empty unless the old app explicitly needs to bridge its authenticated session.
LEGACY_SESSION_BRIDGE_TOKEN=
